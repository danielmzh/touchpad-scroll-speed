#: extension/extension.js:57
msgid "Touchpad Scroll Speed"
msgstr "Velocidad de desplazamiento del panel táctil"

#: extension/extension.js:63 extension/prefs.js:21
msgid "Touchpad scrolling"
msgstr "Desplazamiento del panel táctil"

#: extension/extension.js:72
msgid "Install the scroll component from the project, then log out and log back in."
msgstr "Instala el componente de desplazamiento desde el proyecto; luego cierra sesión y vuelve a entrar."

#: extension/extension.js:73
msgid "A GNOME Wayland session is required."
msgstr "Se requiere una sesión GNOME con Wayland."

#: extension/extension.js:85
msgid "Two-finger scrolling"
msgstr "Desplazamiento con dos dedos"

#: extension/extension.js:101
msgid "Touchpad scroll speed"
msgstr "Velocidad de desplazamiento del panel táctil"

#: extension/extension.js:118
msgid "Slower"
msgstr "Más lento"

#: extension/extension.js:119
msgid "Faster"
msgstr "Más rápido"

#: extension/extension.js:125
#, javascript-format
msgid "%s · %s"
msgstr "%s · %s"

#: extension/extension.js:132
msgid "Reset speed"
msgstr "Restablecer velocidad"

#: extension/extension.js:139
msgid "Preferences…"
msgstr "Preferencias…"

#: extension/extension.js:166
#, javascript-format
msgid "Touchpad scrolling: %s"
msgstr "Desplazamiento del panel táctil: %s"

#: extension/extension.js:188
msgid "Could not apply the scroll speed."
msgstr "No se pudo aplicar la velocidad de desplazamiento."

#: extension/prefs.js:31
msgid "Settings unavailable"
msgstr "Configuración no disponible"

#: extension/prefs.js:32
msgid "Reinstall the extension to restore the scrolling settings."
msgstr "Reinstala la extensión para recuperar la configuración del desplazamiento."

#: extension/prefs.js:43
msgid "Scrolling speed"
msgstr "Velocidad de desplazamiento"

#: extension/prefs.js:44
msgid "Adjust two-finger scrolling. 100 % is the normal speed."
msgstr "Ajusta el desplazamiento con dos dedos. 100 % es la velocidad normal."

#: extension/prefs.js:68
msgid "Two-finger scrolling speed; 100 % is the normal speed"
msgstr "Velocidad de desplazamiento con dos dedos; 100 % es la velocidad normal"

#: extension/prefs.js:81
msgid "Scroll speed"
msgstr "Velocidad de desplazamiento"

#: extension/prefs.js:82
#, javascript-format
msgid "%s: slower · 100 %%: normal · %s: faster"
msgstr "%s: más lento · 100 %%: normal · %s: más rápido"

#: extension/prefs.js:114
msgid "Quick presets"
msgstr "Accesos rápidos"

#: extension/prefs.js:123
#, javascript-format
msgid "Set scrolling to %s"
msgstr "Establecer el desplazamiento en %s"

#: extension/prefs.js:137
msgid "Reset"
msgstr "Restablecer"

#: extension/prefs.js:148
msgid "Reset scrolling"
msgstr "Restablecer desplazamiento"

#: extension/prefs.js:149
msgid "Restore the normal speed (100 %)."
msgstr "Vuelve a la velocidad normal (100 %)."

#: extension/prefs.js:160
msgid "Apply the setting"
msgstr "Aplicar el ajuste"

#: extension/prefs.js:161
msgid "Install the scroll component from the project, then log out and log back in. Disabling the extension restores normal speed and keeps your setting."
msgstr "Instala el componente de desplazamiento desde el proyecto; luego cierra sesión y vuelve a entrar. Al desactivar la extensión se usa la velocidad normal y se conserva tu ajuste."

#: extension/prefs.js:166
msgid "Installation instructions"
msgstr "Instrucciones de instalación"

#: extension/prefs.js:171
msgid "Scroll component"
msgstr "Componente de desplazamiento"

#: extension/prefs.js:172
msgid "The GNOME Extensions package needs the scroll component installed separately."
msgstr "El paquete de GNOME Extensions requiere instalar el componente de desplazamiento por separado."

#: extension/speed.js:11
msgid "Slow"
msgstr "Lenta"

#: extension/speed.js:12
msgid "Normal"
msgstr "Normal"

#: extension/speed.js:13
msgid "Fast"
msgstr "Rápida"
